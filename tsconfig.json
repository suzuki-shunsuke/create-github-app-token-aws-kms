{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    // Without this, @types/node isn't picked up and every Node global goes missing.
    "types": ["node"],
  },
  "exclude": ["node_modules", "eslint.config.ts"],
}
